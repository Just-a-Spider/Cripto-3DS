# ==========================================
# Cripto-3DS Engine Configuration Template
# Copy this file to .env or configure via Web Companion
# ==========================================

# --- Binance API Credentials ---
# (Can also be entered securely via the Web Companion Settings UI)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true

# --- Discord Gateway Bot Integration (Optional) ---
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_WEBHOOK_URL=

# --- Google AI Studio (Gemini Free Tier) ---
# Get a free API key at https://aistudio.google.com
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Server Ports & Security ---
AUTH_PIN=1234
SERVER_3DS_PORT=7343
WEB_PORT=7344
HEADLESS=true
