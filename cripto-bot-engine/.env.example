# ==========================================
# Cripto-3DS Engine Configuration Template
# Copy to .env or run: uv run python setup_env.py
# ==========================================

# --- Operator Security & Authentication ---
AUTH_PIN=1234
ALLOWED_DISCORD_USER_IDS=123456789012345678

# --- Network & Server Ports ---
SERVER_3DS_PORT=7343
WEB_PORT=7344
HEADLESS=true

# --- Binance API Credentials (Testnet or Live) ---
BINANCE_TESTNET=true
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# --- Discord Gateway Bot Integration (Optional) ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_WEBHOOK_URL=

# --- Universal AI Provider (LangChain Engine) ---
# Supported providers: google, groq, openai, anthropic, deepseek, ollama, openrouter, custom
AI_PROVIDER=google
AI_MODEL=gemini-3.1-flash
AI_API_KEY=your_google_ai_studio_api_key_here
AI_BASE_URL=

# Fallback AI Provider
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
AI_FALLBACK_API_KEY=your_groq_api_key_here

# --- Search Grounding & Legacy Keys ---
ENABLE_SEARCH_GROUNDING=false
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.1-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# NOTE: Dynamic Trading Strategies & Risk Limits
# ==============================================================================
# All runtime strategy parameters (Wilder RSI, Bollinger Bands, Take Profit,
# Stop Loss, Trailing Stops, Max Spend Caps, Pair Watchlist, and Approval Gates)
# are configured and hot-reloaded dynamically from the Web Companion dashboard
# (http://localhost:7344/web) and safely persisted in SQLite (bot_data.db).
